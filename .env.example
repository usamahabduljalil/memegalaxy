# No fallback authentication exists. Missing Privy configuration disables paid APIs.

# Keep invite-only until full testnet verification is complete.
ENTRY_ACCESS_MODE=invite-only
BETA_TESTER_WALLETS=
SERVICE_ROLE=game

# Public deployment block; worker backfills confirmed entry/refund history.
ESCROW_DEPLOYMENT_BLOCK=
