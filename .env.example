# Copy to .env. Never commit real keys. Browser values are PUBLIC.
VITE_PRIVY_APP_ID=
VITE_API_URL=http://localhost:2567
VITE_WS_URL=ws://localhost:2567
VITE_ESCROW_ADDRESS=
VITE_DOMINATE_ADDRESS=
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
VITE_FAUCET_ADDRESS=
VITE_RPC_URL=https://rpc.testnet.arc.io

# Server and worker secrets. Testnet ONLY.
PORT=2567
DATABASE_URL=postgres://bigcircle:bigcircle@localhost:5432/bigcircle
PRIVY_APP_ID=
PRIVY_APP_SECRET=
ADMISSION_SECRET=
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ARC_RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
ESCROW_ADDRESS=
DOMINATE_ADDRESS=
USDC_ADDRESS=0x3600000000000000000000000000000000000000
FAUCET_ADDRESS=
RESULT_SIGNER_PRIVATE_KEY=
REGISTRAR_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
OPERATIONS_ADDRESS=
ADMIN_ADDRESS=
ENABLE_PAID_EPOCHS=false
# No fallback authentication exists. Missing Privy configuration disables paid APIs.

# Keep invite-only until full testnet verification is complete.
ENTRY_ACCESS_MODE=invite-only
BETA_TESTER_WALLETS=
SERVICE_ROLE=game

# Public deployment block; worker backfills confirmed entry/refund history.
ESCROW_DEPLOYMENT_BLOCK=

# MEMEGalaxy hosted platform (Robinhood testnet only).
VITE_MEMEGALAXY_API_URL=http://127.0.0.1:2568
VITE_MEMEGALAXY_LIVE=true
MEMEGALAXY_DATABASE_URL=
MEMEGALAXY_API_URL=http://127.0.0.1:2568
MEMEGALAXY_SITE_URL=http://127.0.0.1:5173
MEMEGALAXY_ADMISSION_SECRET=
MEMEGALAXY_WEB_ORIGINS=http://127.0.0.1:5173
MEMEGALAXY_HOSTED_RUNTIME=false
MEMEGALAXY_AGENT_PORT=2570
MEMEGALAXY_AGENT_MODEL=gpt-6-luna
OPENAI_API_KEY=
# JSON private signing JWKS and cookie secret; server-side only.
MCP_JWKS=
MCP_COOKIE_SECRET=
# Temporary release probes; disable after verification.
MEMEGALAXY_VERIFY_HOSTED=false
MEMEGALAXY_VERIFY_RUNTIME=false

# Stock Hunt / GalaxyUsd economy (testnet only; no user secret values here).
MEMEGALAXY_HUNT_VAULT=
MEMEGALAXY_RETIREMENT_ADDRESS=
MEMEGALAXY_ECONOMY_START_BLOCK=
MEMEGALAXY_ECONOMY_ADMINS=
MEMEGALAXY_ECONOMY_CONFIRMATIONS=12
MEMEGALAXY_VERIFY_ECONOMY=false
# Optional social verification. Bot must be a Telegram group/channel administrator.
MEMEGALAXY_TELEGRAM_BOT_NAME=
MEMEGALAXY_TELEGRAM_BOT_TOKEN=
MEMEGALAXY_X_CLIENT_ID=
MEMEGALAXY_X_CLIENT_SECRET=
MEMEGALAXY_X_REDIRECT_URI=

# One-time staging probes, normally false.
MEMEGALAXY_VERIFY_ECONOMY_FLOW=false
MEMEGALAXY_VERIFY_HUNT_LOAD=false
MEMEGALAXY_ACTIVATE_TEST_HUNT=false
