# Temporary staging verification image. Normal services use Dockerfile.
FROM node:22-bookworm-slim
WORKDIR /app
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev --legacy-peer-deps --no-audit --no-fund
RUN npm install --no-save --legacy-peer-deps --no-audit --no-fund ganache@7.9.2 solc@0.8.30 @openzeppelin/contracts@5.3.0
COPY server ./server
COPY shared ./shared
COPY sdk ./sdk
COPY contracts ./contracts
COPY scripts ./scripts
ENV NODE_ENV=production
CMD ["npm","run","server"]
