{
  "projectId": "8ffa93c5-986d-4ff9-8574-f0c540136885",
  "environmentId": "6c771e07-deac-4af1-b31e-f3a5df3b5339",
  "databaseServiceId": "8e46d040-9fc1-4fd4-82bb-d68e0793600a",
  "services": [
    {
      "id": "80a636ce-d697-447a-b4c4-8c052858ac89",
      "name": "big-circle-game",
      "startCommand": "npm run server",
      "healthcheckPath": "/health",
      "environment": {
        "SERVICE_ROLE": "game"
      }
    },
    {
      "id": "ce23cb8b-f9f2-42b0-8545-8871dbeb6f4b",
      "name": "big-circle-worker",
      "startCommand": "npm run worker",
      "healthcheckPath": null,
      "environment": {
        "SERVICE_ROLE": "worker"
      }
    }
  ],
  "shared": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "preDeployCommand": [
      "npm run db:migrate"
    ],
    "replicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  },
  "note": "Public deployment identifiers only. Store secrets in Railway. The image runs locked migrations on startup; SERVICE_ROLE selects the worker because image start-command overrides were not applied by the service settings API."
}
