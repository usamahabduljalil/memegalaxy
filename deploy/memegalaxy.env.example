# Copy to .env. Real keys stay outside Git. VITE_ settings are public.
VITE_MEMEGALAXY_API_URL=http://127.0.0.1:2568
VITE_ZERODEV_PROJECT_ID=1ced0ec0-74be-4a75-9dae-ef8d8d5470e8
# Resume only after ZeroDev OTP delivery and verification pass.
VITE_ZERODEV_EMAIL_ENABLED=false

# Robinhood Chain testnet only. ETH pays network gas.
SERVICE_ROLE=galaxy-game
PORT=2568
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
MEMEGALAXY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/memegalaxy
MEMEGALAXY_API_URL=http://127.0.0.1:2568
MEMEGALAXY_SITE_URL=http://127.0.0.1:5173
MEMEGALAXY_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MEMEGALAXY_ADMISSION_SECRET=

# Prize assets and signatures. Deployer key stays local.
MEMEGALAXY_ENABLE_PRIZES=false
MEMEGALAXY_ENTROPY_SOURCE=contract
MEMEGALAXY_ESCROW_ADDRESS=
MEMEGALAXY_TOKEN_ADDRESS=
MEMEGALAXY_USDC_ADDRESS=
MEMEGALAXY_FAUCET_ADDRESS=
MEMEGALAXY_ESCROW_DEPLOYMENT_BLOCK=
REGISTRAR_PRIVATE_KEY=
RESULT_SIGNER_PRIVATE_KEY=
MEMEGALAXY_OPERATOR_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
ADMIN_ADDRESS=
OPERATIONS_ADDRESS=

# Hosted agents and MCP. Server-only secrets.
MEMEGALAXY_HOSTED_RUNTIME=false
MEMEGALAXY_AGENT_PORT=2570
MEMEGALAXY_AGENT_MODEL=gpt-6-luna
OPENAI_API_KEY=
MCP_JWKS=
MCP_COOKIE_SECRET=

# Stock Hunt and GalaxyUsd economy. Offers require operator configuration.
MEMEGALAXY_HUNT_VAULT=
MEMEGALAXY_RETIREMENT_ADDRESS=
MEMEGALAXY_ECONOMY_START_BLOCK=
MEMEGALAXY_ECONOMY_ADMINS=
MEMEGALAXY_ECONOMY_CONFIRMATIONS=12
MEMEGALAXY_TELEGRAM_BOT_NAME=
MEMEGALAXY_TELEGRAM_BOT_TOKEN=
MEMEGALAXY_X_CLIENT_ID=
MEMEGALAXY_X_CLIENT_SECRET=
MEMEGALAXY_X_REDIRECT_URI=

# Optional staging probes. Normally false.
MEMEGALAXY_VERIFY_HOSTED=false
MEMEGALAXY_VERIFY_RUNTIME=false
MEMEGALAXY_VERIFY_ECONOMY=false
MEMEGALAXY_VERIFY_ECONOMY_FLOW=false
MEMEGALAXY_VERIFY_HUNT_LOAD=false
MEMEGALAXY_ACTIVATE_TEST_HUNT=false
