# Separate MEMEGalaxy service configuration. Never reuse Arc contract addresses.
SERVICE_ROLE=galaxy-game
PORT=2568
MEMEGALAXY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memegalaxy
MEMEGALAXY_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MEMEGALAXY_ADMISSION_SECRET=
PRIVY_APP_ID=cmu4adz9p00pe0djnenbuyhc0
PRIVY_APP_SECRET=
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
MEMEGALAXY_ENABLE_PRIZES=false
MEMEGALAXY_ESCROW_ADDRESS=
MEMEGALAXY_TOKEN_ADDRESS=
MEMEGALAXY_USDC_ADDRESS=
MEMEGALAXY_FAUCET_ADDRESS=
# Registrar signs entry permits. Its separate role also coordinates epoch openings.
REGISTRAR_PRIVATE_KEY=
# Result signer cannot administer treasury or open epochs.
RESULT_SIGNER_PRIVATE_KEY=
# Optional dedicated coordinator key; defaults to registrar key when omitted.
MEMEGALAXY_OPERATOR_PRIVATE_KEY=
# Frontend public configuration
VITE_MEMEGALAXY_API_URL=http://127.0.0.1:2568
VITE_PRIVY_APP_ID=cmu4adz9p00pe0djnenbuyhc0
